---
import Layout from '~/layouts/Layout.astro';
import heroImage from '~/assets/images/rsz_horse_riding_ushguli63.jpg';
import toursImage from '~/assets/images/horse_riding_ushguli_22.jpg';

// Widgets
import Hero2 from '~/components/widgets/Hero2.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Horse Riding Ushguli, Svaneti, Georgia',
};
---

<Layout metadata={metadata}>
  <!-- Hero: main above-the-fold section -->
  <Hero2
    tagline="Horse Riding Ushguli"
    title="Explore Ushguli and Svaneti on horseback."
    subtitle="Experience the breathtaking beauty of Svaneti as you explore its ancient villages, alpine meadows, and legendary mountain trails on horseback. Saddle up for an unforgettable adventure and discover why this extraordinary region of Georgia is best seen from the back of a horse."
    actions={[
      {
        variant: 'primary',
        text: 'Book your ride',
        href: 'https://wa.me/995599038579?text=Hi%2C%20I%27m%20interested%20in%20horse%20riding%20in%20Ushguli',
        icon: 'tabler:square-rounded-arrow-right',
      },
      { text: 'Learn more', href: '#tours' },
    ]}
    image={{
      src: heroImage,
      alt: 'Horse Riding in Ushguli, Svaneti, Georgia.',
      width: heroImage.width,
      height: heroImage.height,
    }}
  />

<section id="tours" class="pt-8 pb-16 md:pt-10 md:pb-20 bg-page">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <Features2
        title="Choose the best tour for you, or contact us to create your own itinerary"
        tagline="Popular Routes"
        columns={4}
        image={{
          src: toursImage,
          alt: 'Horse riding and tower village in Ushguli, Svaneti, Georgia.',
        }}
        items={[
          {
            title: 'Shkhara Glacier day ride – 100 GEL',
            description:
              'Ride from Ushguli towards Georgia’s highest peak, crossing alpine meadows and river valleys. Same‑day trip.',
          },
          {
            title: 'Tsamkvami Lake – 150 GEL',
            description: 'Beautiful same‑day ride to Tsamkvami Lake with quiet trails and great views.',
          },
          {
            title: 'The Pass – 150 GEL',
            description: 'Same‑day climb to a scenic mountain pass with panoramic views over Svaneti.',
          },
          {
            title: 'Gorvashi Lake – 150 GEL',
            description: 'Day tour to Gorvashi Lake through forests and open meadows.',
          },
          {
            title: 'Latfari Mountain – 150 GEL',
            description: 'Latfari Mountain same‑day ride with sustained climbing and big‑mountain scenery.',
          },
          {
            title: 'Gamkolli – 200 GEL',
            description: 'Full‑day Gamkolli adventure with varied terrain and the biggest views of the area.',
          },
        ]}
      />
    </div>
  </section>

  <!-- About section, using token-based text colors -->
  <section class="py-16 md:py-24 bg-page">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-page">
      <p class="text-sm font-semibold tracking-wide uppercase text-primary mb-3">About us</p>
      <h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-[color:var(--aw-color-text-heading)] mb-6">
        Local guides, mountain horses, real Svaneti experiences
      </h2>
      <p class="leading-relaxed mb-4">
        We are a small, local team based in Ushguli, working with experienced mountain horses and guides who know every
        trail, river crossing, and weather pattern in the valley.
      </p>
      <p class="leading-relaxed text-muted">
        Whether it is your first time on horseback or you are an experienced rider, we’ll match you with the right
        horse, route, and pace so you can relax, feel safe, and fully enjoy the mountains.
      </p>
    </div>
  </section>

  <!-- Call to action, same container + background -->
  <section class="py-16 md:py-24 bg-page">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-page">
      <CallToAction
        title="Ready to ride in Ushguli?"
        subtitle="Send us a WhatsApp message with your preferred dates, group size, and riding experience. We’ll reply with suggested routes and prices."
        actions={[
          {
            variant: 'primary',
            text: 'Book your ride on WhatsApp',
            href: 'https://wa.me/995599038579?text=Hi%2C%20I%27m%20interested%20in%20horse%20riding%20in%20Ushguli',
          },
        ]}
      />
    </div>
  </section>
</Layout>
