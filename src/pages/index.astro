---
import Layout from '~/layouts/Layout.astro';
import Image from '~/components/common/Image.astro';

import heroImage from '~/assets/images/rsz_horse_riding_ushguli63.jpg';
import toursImage from '~/assets/images/horse_riding_ushguli_224.jpg';
import aboutImage from '~/assets/images/horse_riding_ishguli2224.jpg';
import ogImage from '~/assets/images/og-ushguli.jpg';
import goldenHourHorses from '~/assets/images/golden-hour-horses.jpg';
import churchBells from '~/assets/images/church-bells.jpg';
import ushguliTowersSun from '~/assets/images/ushguli-towers-sun.jpg';
import shkharaAlpenglow from '~/assets/images/shkhara-alpenglow.jpg';

import gallery1 from '~/assets/images/gallery1.jpg';
import gallery2 from '~/assets/images/gallery2.jpg';
import gallery3 from '~/assets/images/gallery3.jpg';
import gallery4 from '~/assets/images/gallery4.jpg';
import gallery5 from '~/assets/images/gallery5.jpg';
import gallery6 from '~/assets/images/gallery6.jpg';
import gallery7 from '~/assets/images/gallery7.jpg';
import gallery9 from '~/assets/images/gallery9.jpg';
import gallery10 from '~/assets/images/gallery10.jpg';
import gallery11 from '~/assets/images/gallery11.jpg';
import gallery12 from '~/assets/images/gallery12.jpg';
import gallery13 from '~/assets/images/gallery13.jpg';
import gallery14 from '~/assets/images/gallery14.jpg';
import gallery15 from '~/assets/images/gallery15.jpg';
import gallery16 from '~/assets/images/gallery16.jpg';
import gallery17 from '~/assets/images/gallery17.jpg';
import gallery18 from '~/assets/images/gallery18.jpg';
import gallery19 from '~/assets/images/gallery19.jpg';

import GallerySlider from '~/components/widgets/GallerySlider.astro';

type Tile =
  | { kind: 'video'; name: string; alt: string; cls: string }
  | { kind: 'photo'; src: ImageMetadata; alt: string; cls: string; position?: string; big?: boolean };

// Photos and clips alternate so no two videos sit side by side or one above the other (on wide screens).
const collage: Tile[] = [
  {
    kind: 'video',
    name: 'guide-black-horse',
    alt: 'A guide with a saddled black horse on a slope above the valley.',
    cls: 'col-span-2 md:row-span-2 aspect-video md:aspect-auto',
  },
  {
    kind: 'photo',
    src: heroImage,
    alt: 'A saddled bay horse grazing below the snow-covered Shkhara massif.',
    cls: 'row-span-2',
    position: '50% 70%',
  },
  {
    kind: 'photo',
    src: churchBells,
    alt: 'Three church bells hanging on a wooden frame in Ushguli, with snowy peaks behind.',
    cls: 'aspect-video',
  },
  {
    kind: 'video',
    name: 'towers-road',
    alt: 'A dog trotting along the village road between Svan towers.',
    cls: 'aspect-video',
  },
  {
    kind: 'photo',
    src: ushguliTowersSun,
    alt: 'The Svan towers of Ushguli on a sunny afternoon.',
    cls: 'aspect-video',
  },
  {
    kind: 'photo',
    src: shkharaAlpenglow,
    alt: 'Shkhara glowing pink at sunset above the clouds.',
    cls: 'aspect-video',
  },
  {
    kind: 'video',
    name: 'cows-road',
    alt: 'Cows wandering along the road in Ushguli below Shkhara.',
    cls: 'aspect-video',
  },
  { kind: 'photo', src: gallery12, alt: 'A stone Svan tower under fresh snow.', cls: 'aspect-video' },
  {
    kind: 'video',
    name: 'rider-slope',
    alt: 'A rider leading a saddled horse across a high slope above the valley.',
    cls: 'col-span-2 aspect-video',
  },
  {
    kind: 'photo',
    src: goldenHourHorses,
    alt: 'Two horses grazing on stony ground in the evening light, with snowy peaks at the head of the valley.',
    cls: 'col-span-2 aspect-video',
    big: true,
  },
  {
    kind: 'photo',
    src: gallery1,
    alt: 'A guide with a bay and a grey horse beside a small lake below Shkhara glacier.',
    cls: 'col-span-2 aspect-video',
    position: '50% 100%',
    big: true,
  },
  {
    kind: 'video',
    name: 'snow-valley',
    alt: 'Fresh snow on the peaks at the head of the valley.',
    cls: 'col-span-2 aspect-video',
  },
];

const metadata = {
  title: 'Horse Riding in Ushguli, Svaneti, Georgia | Day Rides',
};

// Facts still waiting on the horseman are `null`. In `npm run dev` they show as
// highlighted "To confirm" notes; in the production build the line is left out.
const showPlaceholders = import.meta.env.DEV;

const phoneDisplay = '+995 599 03 85 79';
const whatsappHref = 'https://wa.me/995599038579?text=Hi%2C%20I%27m%20interested%20in%20horse%20riding%20in%20Ushguli';
const googleMapsHref: string | null = null; // Google Business Profile link, once it exists

type Route = {
  name: string;
  price: number;
  summary: string;
  duration: string | null;
  difficulty: string | null;
};

const routes: Route[] = [
  {
    name: 'Shkhara Glacier',
    price: 100,
    summary: 'Ride from Ushguli towards Shkhara, Georgia’s highest peak, crossing alpine meadows and river valleys.',
    duration: null,
    difficulty: null,
  },
  {
    name: 'Tsamkvami Lake',
    price: 150,
    summary: 'A ride to Tsamkvami Lake on quiet trails, with wide mountain views.',
    duration: null,
    difficulty: null,
  },
  {
    name: 'The Pass',
    price: 150,
    summary: 'A steady climb to a mountain pass with panoramic views over Svaneti.',
    duration: null,
    difficulty: null,
  },
  {
    name: 'Gorvashi Lake',
    price: 150,
    summary: 'Through forest and open meadow to Gorvashi Lake.',
    duration: null,
    difficulty: null,
  },
  {
    name: 'Latfari Mountain',
    price: 150,
    summary: 'A long, sustained climb with big-mountain scenery all the way up.',
    duration: null,
    difficulty: null,
  },
  {
    name: 'Gamkolli',
    price: 200,
    summary: 'A full day over varied ground, with the biggest views in the area.',
    duration: null,
    difficulty: null,
  },
];

type Fact = { label: string; value: string | null; hint?: string };

const goodToKnow: Fact[] = [
  { label: 'Season', value: null, hint: 'which months the rides run' },
  { label: 'Meeting point', value: null, hint: 'where riders meet in Ushguli, ideally with a map pin' },
  { label: 'Included', value: null, hint: 'guide, horse, helmet? lunch or snacks?' },
  { label: 'Who can ride', value: null, hint: 'beginners welcome? minimum age, weight limit' },
  { label: 'Payment', value: null, hint: 'cash in GEL on the day? deposit?' },
  {
    label: 'What to bring',
    value:
      'Long trousers, closed shoes with a small heel, warm and waterproof layers (the weather turns fast in the mountains), sun cream, sunglasses and water.',
  },
  {
    label: 'Booking',
    value: `Send us a WhatsApp message with your dates, group size and riding experience. Want something longer or different? Ask and we’ll plan your own route.`,
  },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': 'https://www.horseridingushguli.com/#business',
  name: 'Horse Riding Ushguli',
  description:
    'Guided same-day horse rides from Ushguli, Svaneti, Georgia, to Shkhara Glacier, mountain lakes and passes.',
  url: 'https://www.horseridingushguli.com/',
  image: new URL(ogImage.src, Astro.site).toString(),
  telephone: '+995599038579',
  priceRange: '100–200 GEL',
  currenciesAccepted: 'GEL',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ushguli',
    addressRegion: 'Samegrelo-Zemo Svaneti',
    addressCountry: 'GE',
  },
  areaServed: 'Svaneti, Georgia',
  ...(googleMapsHref ? { hasMap: googleMapsHref } : {}),
  makesOffer: routes.map((route) => ({
    '@type': 'Offer',
    price: route.price,
    priceCurrency: 'GEL',
    itemOffered: {
      '@type': 'TouristTrip',
      name: `${route.name} horse ride from Ushguli`,
      description: route.summary,
    },
  })),
};
---

<Layout metadata={metadata}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <a href="#main" class="skip">Skip to content</a>

  <!-- Hero: video on wide screens and a vertical clip on phones; photo poster underneath -->
  <section class="hero relative isolate overflow-hidden bg-[#221f1b] text-white" data-hero>
    <picture>
      <source media="(orientation: portrait)" srcset="/video/hero-tall.jpg" />
      <img
        src="/video/hero-wide.jpg"
        alt=""
        class="absolute inset-0 -z-20 h-full w-full object-cover hero-media"
        fetchpriority="high"
      />
    </picture>
    <video
      class="absolute inset-0 -z-10 h-full w-full object-cover hero-media"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      data-hero-video
    >
      <source media="(orientation: portrait)" src="/video/hero-tall.mp4" type="video/mp4" />
      <source src="/video/hero-wide.mp4" type="video/mp4" />
    </video>
    <div class="hero-shade absolute inset-0 -z-10"></div>

    <header class="site-header">
      <div class="wrap flex items-center justify-between gap-6">
        <a href="/" class="wordmark">Horse Riding Ushguli</a>
        <nav aria-label="Main" class="flex items-center gap-6 text-[15px]">
          <a class="nav-link hidden md:inline" href="#place">Ushguli</a>
          <a class="nav-link hidden md:inline" href="#tours">Routes</a>
          <a class="nav-link hidden md:inline" href="#good-to-know">Good to know</a>
          <a class="pill pill-light" href={whatsappHref}>Book</a>
        </nav>
      </div>
    </header>

    <div class="hero-content wrap flex flex-col">
      <div class="max-w-2xl">
        <p class="eyebrow text-white/80">Ushguli · Svaneti · Georgia</p>
        <h1 class="display mt-4 text-white">Explore Ushguli and Svaneti on horseback.</h1>
        <p class="mt-5 text-lg md:text-xl text-white/90 max-w-xl leading-relaxed">
          Ride past ancient villages and alpine meadows towards Shkhara, Georgia’s highest peak, with local guides and
          mountain horses.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="pill pill-accent" href={whatsappHref}>Book on WhatsApp</a>
          <a class="pill pill-ghost" href="#tours">See the routes</a>
        </div>
      </div>
    </div>
    <p class="sr-only">
      Video: saddled horses grazing in an autumn meadow below the snow-covered Shkhara massif near Ushguli.
    </p>
  </section>

  <main id="main">
    <!-- The place -->
    <section id="place" class="section">
      <div class="wrap grid gap-8 md:grid-cols-12">
        <p class="eyebrow text-accent md:col-span-3 md:pt-3">The place</p>
        <div class="md:col-span-9">
          <p class="statement">
            Ushguli is a cluster of four villages at the head of the Enguri valley in Upper Svaneti, beneath Shkhara,
            Georgia’s highest peak. Its medieval stone towers are part of a UNESCO World Heritage Site, and the trails
            around it lead to glaciers, high lakes and mountain passes.
          </p>
          <ul class="facts mt-10">
            <li><span class="fact-value">UNESCO</span><span class="fact-label">World Heritage, Upper Svaneti</span></li>
            <li><span class="fact-value">Shkhara</span><span class="fact-label">Georgia’s highest peak</span></li>
            <li><span class="fact-value">Six</span><span class="fact-label">same-day rides from the village</span></li>
          </ul>
        </div>
      </div>
    </section>

    <figure class="band">
      <Image
        src={toursImage}
        widths={[768, 1280, 1920, 2400]}
        sizes="100vw"
        loading="lazy"
        alt="The stone Svan towers of Ushguli on a sunny day."
        class="h-full w-full"
        style=";object-fit:cover;max-width:none;max-height:none;aspect-ratio:auto;height:100%"
      />
    </figure>

    <!-- Routes -->
    <section id="tours" class="section">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-12 mb-10 md:mb-14">
          <p class="eyebrow text-accent md:col-span-3 md:pt-4">Day rides</p>
          <div class="md:col-span-9">
            <h2 class="h2">Six routes from the village</h2>
            <p class="lede mt-4">
              All rides are same-day trips. Prices are per rider, in Georgian lari. Want something longer or different?
              Message us and we’ll plan your own route.
            </p>
          </div>
        </div>

        <ol class="routes">
          {
            routes.map((route, index) => (
              <li class="route">
                <span class="route-number">{String(index + 1).padStart(2, '0')}</span>
                <h3 class="route-name">{route.name}</h3>
                <p class="route-price">
                  {route.price} <span>GEL</span>
                </p>
                <div class="route-body">
                  <p class="route-summary">{route.summary}</p>
                  {(route.duration || route.difficulty || showPlaceholders) && (
                    <p class="route-meta">
                      <span>{route.duration ?? <span class="tbc">To confirm: hours in the saddle</span>}</span>
                      <span>{route.difficulty ?? <span class="tbc">To confirm: easy, moderate or hard</span>}</span>
                    </p>
                  )}
                </div>
              </li>
            ))
          }
        </ol>

        <p class="mt-10">
          <a class="pill pill-accent" href={whatsappHref}>Ask about a ride</a>
        </p>
      </div>
    </section>

    <!-- About -->
    <section class="section pt-0">
      <div class="wrap grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-6">
          <Image
            class="w-full rounded-[3px]"
            widths={[480, 768, 1024, 1440]}
            sizes="(max-width: 1023px) 100vw, 50vw"
            loading="lazy"
            src={aboutImage}
            alt="Three riders on a gravel valley track near Ushguli, heading towards the mountains."
          />
        </div>
        <div class="lg:col-span-5 lg:col-start-8">
          <p class="eyebrow text-accent">Who we are</p>
          <h2 class="h2 mt-4">Local guides, mountain horses, real Svaneti</h2>
          <p class="mt-6 leading-relaxed text-lg">
            We are a small, local team based in Ushguli, working with experienced mountain horses and guides who know
            every trail, river crossing, and weather pattern in the valley.
          </p>
          <p class="mt-4 leading-relaxed text-lg">
            Whether it is your first time on horseback or you are an experienced rider, we’ll match you with the right
            horse, route, and pace so you can relax, feel safe, and fully enjoy the mountains.
          </p>
        </div>
      </div>
    </section>

    <!-- Collage of short clips and photos -->
    <section class="section section-tint">
      <div class="wrap">
        <div class="grid gap-6 md:grid-cols-12 mb-10 md:mb-14">
          <p class="eyebrow text-accent md:col-span-3 md:pt-4">Around Ushguli</p>
          <h2 class="h2 md:col-span-9">Towers, glaciers and the horses that know the way</h2>
        </div>
        <div class="collage grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-5">
          {
            collage.map((tile) =>
              tile.kind === 'video' ? (
                <figure class={tile.cls}>
                  <video muted loop playsinline preload="none" poster={`/video/${tile.name}.jpg`} data-loop>
                    <source src={`/video/${tile.name}.mp4`} type="video/mp4" />
                  </video>
                  <figcaption class="sr-only">{tile.alt}</figcaption>
                </figure>
              ) : (
                <figure class={tile.cls}>
                  <Image
                    src={tile.src}
                    widths={tile.big ? [480, 768, 1024, 1600] : [400, 640, 800]}
                    sizes={tile.big ? '(max-width: 767px) 100vw, 600px' : '(max-width: 767px) 50vw, 300px'}
                    alt={tile.alt}
                    class="h-full w-full"
                    style={`;object-fit:cover;object-position:${tile.position ?? '50% 50%'};max-width:none;max-height:none;aspect-ratio:auto;height:100%`}
                  />
                </figure>
              )
            )
          }
        </div>
      </div>
    </section>

    <!-- Good to know -->
    <section id="good-to-know" class="section">
      <div class="wrap grid gap-10 md:grid-cols-12">
        <div class="md:col-span-4">
          <p class="eyebrow text-accent">Before you ride</p>
          <h2 class="h2 mt-4">Good to know</h2>
        </div>
        <dl class="md:col-span-8 info">
          {
            goodToKnow
              .filter((fact) => fact.value || showPlaceholders)
              .map((fact) => (
                <div class="info-row">
                  <dt>{fact.label}</dt>
                  <dd>{fact.value ?? <span class="tbc">To confirm: {fact.hint}</span>}</dd>
                </div>
              ))
          }
        </dl>
      </div>
    </section>

    <!-- Gallery -->
    <section class="section pt-0">
      <div class="wrap max-w-5xl">
        <p class="eyebrow text-accent mb-6">More photos</p>
        <h2 class="sr-only">Photos from Ushguli</h2>
        <GallerySlider
          images={[
            gallery13,
            gallery3,
            gallery2,
            gallery17,
            gallery6,
            gallery9,
            gallery10,
            gallery19,
            gallery5,
            gallery16,
            gallery11,
            gallery18,
            gallery15,
            gallery14,
            gallery4,
            gallery7,
          ]}
          altTexts={[
            'Saddled horses tied at a fence, with Shkhara behind.',
            'Ushguli’s towers and houses below the snow-covered Shkhara massif.',
            'Close-up of a traditional leather saddle on a bay horse.',
            'A guide leading a saddled black horse on a high slope above the valley.',
            'The Svan towers of Ushguli with snowy peaks at the head of the valley.',
            'A saddled dark horse in an autumn meadow facing Shkhara.',
            'Shkhara glacier and the rocky moraine below it.',
            'Two saddled horses resting by the bushes beside the track.',
            'Ushguli’s villages and towers seen from the hillside above.',
            'A rider and horse on a high meadow above a winding river valley.',
            'Horses grazing by a river below a snowy ridge.',
            'Looking up at Shkhara between a grey horse’s ears.',
            'Close-up of a grey horse grazing.',
            'Houses in Ushguli below snow-dusted mountains.',
            'A small wooden kiosk and stone houses in Ushguli.',
            'A curious cow among the thistles in a meadow near Ushguli.',
          ]}
        />
      </div>
    </section>

    <!-- Closing call to action -->
    <section class="closing relative isolate overflow-hidden text-white">
      <Image
        src={gallery3}
        widths={[768, 1280, 1920]}
        sizes="100vw"
        loading="lazy"
        alt=""
        class="absolute inset-0 -z-20 h-full w-full"
        style=";object-fit:cover;max-width:none;max-height:none;aspect-ratio:auto;height:100%"
      />
      <div class="absolute inset-0 -z-10 bg-[#221f1b]/60"></div>
      <div class="wrap text-center py-28 md:py-40">
        <p class="eyebrow text-white/80">Book your ride</p>
        <h2 class="display mt-4 text-white">Ready to ride in Ushguli?</h2>
        <p class="mt-5 text-lg md:text-xl text-white/90 max-w-2xl mx-auto leading-relaxed">
          Send us a WhatsApp message with your preferred dates, group size and riding experience. We’ll reply with
          suggested routes and prices.
        </p>
        <p class="mt-8">
          <a class="pill pill-accent" href={whatsappHref}>Book on WhatsApp</a>
        </p>
        <p class="mt-4 text-white/80">or message {phoneDisplay} on WhatsApp</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="wrap grid gap-8 md:grid-cols-12 py-14">
      <div class="md:col-span-6">
        <p class="wordmark text-[#f5f0e7]">Horse Riding Ushguli</p>
        <p class="mt-3 text-[#f5f0e7]/70">Day rides from Ushguli, Upper Svaneti, Georgia.</p>
      </div>
      <div class="md:col-span-6 md:text-right flex flex-col gap-2 md:items-end">
        <a class="footer-link" href={whatsappHref}>WhatsApp {phoneDisplay}</a>
        {
          googleMapsHref ? (
            <a class="footer-link" href={googleMapsHref}>
              Find us on Google Maps
            </a>
          ) : (
            showPlaceholders && <span class="tbc">To confirm: Google Maps link</span>
          )
        }
        <span class="text-[#f5f0e7]/60 text-sm">© {new Date().getFullYear()} Horse Riding Ushguli</span>
      </div>
    </div>
  </footer>

  <a class="pill pill-accent sticky-book" href={whatsappHref} data-sticky-book>Book on WhatsApp</a>
</Layout>

<script is:inline>
  (() => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const hero = document.querySelector('[data-hero-video]');
    if (hero && reduce) {
      hero.removeAttribute('autoplay');
      hero.pause();
    }
    if (!('IntersectionObserver' in window)) return;

    // Phone booking button appears once the hero has scrolled away
    const sticky = document.querySelector('[data-sticky-book]');
    const heroSection = document.querySelector('[data-hero]');
    if (sticky && heroSection) {
      new IntersectionObserver(([entry]) => sticky.classList.toggle('is-visible', !entry.isIntersecting), {
        threshold: 0.1,
      }).observe(heroSection);
    }

    if (reduce) return;
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target;
          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.25 }
    );
    document.querySelectorAll('video[data-loop]').forEach((video) => io.observe(video));
  })();
</script>

<style>
  :global(html) {
    scroll-behavior: smooth;
  }
  :global(body) {
    font-size: 17px;
  }
  :global(main p),
  :global(main dd),
  :global(.hero p) {
    text-wrap: pretty;
  }
  .wrap {
    max-width: 1240px;
    margin-inline: auto;
    padding-inline: 20px;
  }
  @media (min-width: 768px) {
    .wrap {
      padding-inline: 40px;
    }
  }
  .skip {
    position: absolute;
    left: -9999px;
  }
  .skip:focus {
    left: 16px;
    top: 16px;
    z-index: 50;
    background: #fff;
    padding: 8px 12px;
  }
  .text-accent {
    color: var(--aw-color-primary);
  }

  /* Type */
  .eyebrow {
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.06em;
  }
  .display {
    font-family: var(--aw-font-heading);
    font-weight: 400;
    font-size: clamp(2.6rem, 6.2vw, 5.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
    font-variation-settings: 'opsz' 144;
  }
  .h2 {
    font-family: var(--aw-font-heading);
    font-weight: 400;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.08;
    letter-spacing: -0.015em;
    color: var(--aw-color-text-heading);
    font-variation-settings: 'opsz' 120;
  }
  .statement {
    font-family: var(--aw-font-heading);
    font-weight: 350;
    font-size: clamp(1.6rem, 3vw, 2.5rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
    font-variation-settings: 'opsz' 72;
  }
  .lede {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--aw-color-text-muted);
    max-width: 42rem;
  }
